---
---
<!-- 封面区域 -->
<div class="sv-cover">
  <div class="sv-bg"></div>
  <div class="sv-overlay"></div>
  <div class="sv-fireflies" id="sv-fireflies"></div>
  <div class="sv-title">
    <h1>Lovely firefly!</h1>
    <p>在光影与星河间独自漫游</p>
  </div>
</div>

<style is:global>
  .sv-cover {
    position: relative;
    width: 100%;
    height: 65vh;
    min-height: 400px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ===== 这里就是背景图 ===== */
  .sv-bg {
    position: absolute;
    inset: 0;
    background: url('/cover.jpeg') center/cover no-repeat;
    z-index: 1;
  }

  .sv-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,10,30,0.2) 0%, rgba(10,10,30,0.7) 100%);
    z-index: 2;
  }

  .sv-fireflies {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .sv-title {
    position: relative;
    z-index: 4;
    text-align: center;
    color: #fff;
    text-shadow: 0 0 20px rgba(255,255,255,0.6), 0 0 10px rgba(0,0,0,0.5);
  }
  .sv-title h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    margin-bottom: 0.3em;
  }
  .sv-title p {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    letter-spacing: 0.25em;
    opacity: 0.85;
  }
</style>

<script is:inline>
  (function() {
    if (window.__svFireflies) return;
    window.__svFireflies = true;
    const c = document.getElementById('sv-fireflies');
    if (!c) return;
    const types = ['warm','warm','warm','cyan','pink'];
    const COUNT = 80;
    for (let i = 0; i < COUNT; i++) {
      const f = document.createElement('div');
      f.className = 'sv-ff ' + types[Math.floor(Math.random()*types.length)];
      const size = (Math.random()*3 + 1).toFixed(1);
      f.style.cssText = `
        position:absolute;
        width:${size}px;height:${size}px;
        left:${Math.random()*100}vw;
        top:${Math.random()*100}%;
        border-radius:50%;
        animation: svFloat ${Math.random()*6+5}s linear infinite, svTwinkle ${Math.random()*3+2}s ease-in-out infinite alternate;
        animation-delay: ${Math.random()*5}s;
      `;
      c.appendChild(f);
    }
  })();
</script>

<style is:global>
  .sv-ff.warm { background: #ffeb99; box-shadow: 0 0 6px 2px rgba(255,215,0,0.6); }
  .sv-ff.cyan { background: #ccffff; box-shadow: 0 0 6px 2px rgba(0,255,255,0.5); }
  .sv-ff.pink { background: #ffccff; box-shadow: 0 0 6px 2px rgba(255,0,255,0.5); }
  @keyframes svFloat {
    0% { transform: translate(0,0); }
    50% { transform: translate(10px,-30px); }
    100% { transform: translate(-5px,-60px); }
  }
  @keyframes svTwinkle {
    0% { opacity: 0.3; }
    100% { opacity: 1; }
  }
</style>